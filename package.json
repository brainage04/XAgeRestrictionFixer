{
  "name": "x-age-restriction-fixer",
  "private": false,
  "version": "1.0.1",
  "type": "commonjs",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "build:android": "./android-patch/gradlew -p android-patch testDebugUnitTest assembleDebug",
    "build:zip": "node scripts/build-extension-zip.js",
    "check": "npm run lint && npm run format:check",
    "compare:x-dom": "node scripts/compare-x-dom.js",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "lint": "eslint .",
    "reload:extension": "node scripts/reload-extension.js",
    "render:store-assets": "node scripts/render-store-assets.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "chrome-remote-interface": "^0.33.3",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.6"
  }
}
